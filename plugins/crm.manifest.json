  "hooks": [],
  "actions": [
    {
      "id": "on_work_created",
      "trigger": "works.created",
      "steps": [
        {
          "type": "calendar_upsert",
          "title_field": "title",
          "description_field": "description",
          "start_field": "start_at",
          "end_field": "end_at"
        }
      ]
    },
    {
      "id": "on_work_updated",
      "trigger": "works.updated",
      "steps": [
        {
          "type": "calendar_upsert",
          "title_field": "title",
          "description_field": "description",
          "start_field": "start_at",
          "end_field": "end_at"
        }
      ]
    },
    {
      "id": "on_task_created",
      "trigger": "tasks.created",
      "steps": [
        {
          "type": "schedule_reminder",
          "time_field": "due_at",
          "title_field": "title",
          "description_field": "description",
          "repeat_field": "repeat"
        }
      ]
    },
    {
      "id": "on_task_updated",
      "trigger": "tasks.updated",
      "steps": [
        {
          "type": "schedule_reminder",
          "time_field": "due_at",
          "title_field": "title",
          "description_field": "description",
          "repeat_field": "repeat"
        }
      ]
    }
